# All ZeroBias scopes resolve from pkg.zerobias.org, which proxies GitHub Packages
# for the @zerobias-com scope. A single ZB_TOKEN authenticates them all — matching
# what CI provides (deploy.yml sets ZB_TOKEN) and the canonical example-*-v2 /
# auditcrowd apps. Do NOT point @zerobias-com at npm.pkg.github.com directly — the
# deploy's GITHUB_TOKEN (Vault readPackagesToken) cannot read the zerobias-com org.
#
# Get a ZB_TOKEN by creating an API key in the ZeroBias platform, then:
#   export ZB_TOKEN='<your api key>'
# before running `npm install`.
@auditmation:registry=https://pkg.zerobias.org
@auditlogic:registry=https://pkg.zerobias.org
@zerobias-org:registry=https://pkg.zerobias.org
@zerobias-com:registry=https://pkg.zerobias.org
//pkg.zerobias.org/:always-auth=true
//pkg.zerobias.org/:_authToken=${ZB_TOKEN}
